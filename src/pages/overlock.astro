---
// 상세 페이지에 사용할 기본 레이아웃 등을 임포트합니다.
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectDetail4 from "@/components/ProjectDetail4.astro";
// 🚨 1. 프로젝트 메인 이미지 파일을 임포트해야 합니다. 🚨
import antMainImage from "@/images/projects/4.png"; 

// 현재 프로젝트의 모든 상세 데이터를 정의합니다.
const projectData = {
    // 🚨 2. ProjectDetail의 mainImage prop을 채우기 위해 임포트한 이미지를 넣습니다. 🚨
    mainImage: antMainImage,
    
    // 🚨 3. imageAlt prop을 채웁니다. 🚨
    imageAlt: "빈집 (The Ant) 영화 포스터 이미지",
    
    // title은 projectTitle prop을 대신합니다.
    projectTitle: "오버로크 (OVERLOCK)", 
    
    // 🚨 4. category prop을 채웁니다. 🚨
    category: "Sewing & Cultural Complex Brand BI/BX",
    
    // 🚨 5. services prop을 채웁니다. 🚨
    services: ["기획 및 리서치", "BX/BI", "어플리케이션 디자인"],

    award: ["제 19회 한국문화건축공모전 입선", "이화여자대학교 '이 작품을 주목해라' 수상 및 장학금 수여"],
    
    year: "2024",
    
    // 🚨 6. currentPage와 totalPages prop을 채웁니다. (페이지 번호) 🚨
    currentPage: 4, 
    totalPages: 6,
    
    fullDescription: "",
};
---

<BaseLayout>
  <ProjectDetail4 {...projectData} /> 
</BaseLayout>