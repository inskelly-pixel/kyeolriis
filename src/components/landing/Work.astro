---
// assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const data = [
  {
    image: "https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763654237/typemoji_1_1_a3gvlj.svg",
    period: "2025",
    title: "타입이모지 (Typemoji)",
    description: `타입이모지는 글꼴의 형태를 반영한 이모지 제작 프로젝트입니다. 이모지의 형태적 실험과 관련된 어플리케이션을 디자인하였습니다.`,
    location: "Graphic Design",
    link: "/typemoji",
  },
  {
    image: "https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763699603/aboutbeauty2_orzlir.png",
    period: "2024",
    title: "아름다움에 대하여 (About Beauty)",
    description: `네덜란드 제품 디자이너, 베르트얀 핏의 아름다움에 대한 명언을 담은 포스터입니다. 판화 기법을 활용한 출력물과 디지털 인쇄 기법을 활용한 포스터를 제작하였습니다.`,
    location: "Graphic Design",
    link: "/about-beauty",
  },
  {
    image: "https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763703359/700-08_1_kl0c6x.png",
    period: "2024",
    title: "700-08",
    description: `『700-08』은 이화여자대학교의 중앙도서관 서적을 층서학적인 관점에서 분석하는 책입니다. 해당 제목은 예술 서적의 서고 번호를 가리키며 책 종이의 변화가 뚜렷한 700번부터 708번까지의 책들을 중심으로 다루었습니다.`,
    location: "Editorial Design",
    link: "/700-08",
  },
];
---

<section>
  <Wrapper variant="standard">
    <div
      class="grid grid-cols-1 gap-y-12 lg:gap-y-24 md:grid-cols-3 border-b py-8 border-base-200"
    >
      <div class="lg:sticky lg:top-24 lg:z-40 self-start">
        <Text
          tag="h2"
          variant="textSM"
          class="text-base-900 font-bold uppercase"
        >
          Personal Projects
        </Text>
      </div>
      <div
        class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-y-12 gap-x-8"
      >
        {
          data.map((work) => (
            <article class=" relative grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-start lg:sticky ">
              <Image
                width={800}
                height={600}
                src={work.image}
                alt={work.title}
                class="lg:col-span-full aspect-12/7 object-cover object-top w-full"
              />
              <div class="lg:col-span-2">
                <Text
                  tag="h3"
                  variant="textSM"
                  class="text-base-900   font-bold uppercase "
                >
                  <a href={work.link}>
                    <>
                      <span class="absolute -inset-x-4 -inset-y-6 z-20 sm:-inset-x-6 sm:rounded-2xl" />
                      <span class="relative z-10"> {work.title}</span>
                    </>
                  </a>
                </Text>
                <Text
                  tag="p"
                  variant="textXS"
                  class="relative z-10 mt-1 text-base-600          "
                >
                    <span class="leading-[1.7]">
                  {work.description}
                  </span>
                </Text>
                {/* Location 추가 */}
                <Text
                tag="p"
                variant="textXS"
                class="relative z-10 mt-5 text-sm text-base-500"
                >
                <span class="ml-0 w-2 h-2 bg-base-900 rounded-full inline-block"></span>
                {work.location}
                </Text>
              </div>
              <Text
                tag="p"
                variant="textXS"
                class="relative z-10 flex items-center text-sm text-base-600 lg:ml-auto"
              >
                <time datetime={work.period}> {work.period}</time>
              </Text>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
