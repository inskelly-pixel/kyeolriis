---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="pt-8 flex flex-col justify-between h-dvh">
    <div class="flex flex-col lg:flex-row lg:justify-between items-start gap-8">
      <Logo class="max-w-4xl text-black" />
      <div class="flex gap-2 items-center w-fit order-first lg:order-none ml-auto">
        <Text
          tag="a"
          variant="textXS"
          class="text-base-900 hover:text-base-500 font-bold uppercase"
          href="/"
        >
          Home</Text
        >
        <Text
          tag="a"
          variant="textXS"
          class="text-base-900 hover:text-base-500 font-bold uppercase"
          href="/system/overview"
        >
           overview</Text
        >
      </div>
    </div>

    <div
      class="grid grid-cols-1 gap-4 md:grid-cols-3 border-b pb-8 border-base-200"
    >
      <div>
        <Text
          tag="h1"
          variant="textSM"
          class="text-base-900 font-bold uppercase"
          >Communication Designer in Korea Seoul</Text
        >
      </div>
      <div class="lg:col-span-2">
        <Text tag="p" variant="textSM" class="text-base-600 leading-[1.8] w-[660px] mb-10">
          브랜드의 세계관 속에서 ‘하고 싶은 말이 보이도록’ 만드는 커뮤니케이션 디자인을 추구합니다. 방향성과 목적에 맞게 사용자의 관점을 분석하고, 인사이트와 컨셉을 확장하여 브랜드만의 이야기에 힘을 싣고 싶습니다.
        </Text>
      </div>
    </div>
  </Wrapper>
</section>
