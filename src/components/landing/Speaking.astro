---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
const data = [
  {
    period: "2024",
    title: "이화여자대학교 조형예술대학 ‘이 작품을 주목해라’ 작품 선정",
    description: `교내 우수 작품 선정 및 장학금 수여`,
    location: "",
  },
  {
    period: "2024",
    title: "제19회 차세대 문화공간 공모전 입선",
    description: `한국문화공간건축협회 주최 및 동대문 DDP플라자 전시 참여`,
    location: "Design Week, Basel, Switzerland",
  },
   {
    period: "2023",
    title: "이화여자대학교 제3회 해커톤 디자인 대회 우수상",
    description: `대학혁신사업 협업 주최 및 해커톤 디자인 교육 수료`,
    location: "Design Week, Basel, Switzerland",
  },
];
---

<section>
  <Wrapper variant="standard">
    <div
      class="grid grid-cols-1 gap-4 md:grid-cols-3 border-b py-8 border-base-200"
    >
      <div class="lg:sticky lg:top-24 lg:z-40 self-start">
        <Text
          tag="h2"
          variant="textSM"
          class="text-base-900 font-bold uppercase"
        >
          Awards
        </Text>
      </div>
      <div class="flex flex-col gap-12 lg:col-span-2">
        {
          data.map((data) => (
            <article class="group relative grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-start ">
              <div class="lg:col-span-2">
                <Text
                  tag="h3"
                  variant="textSM"
                  class="text-base-900   font-bold uppercase"
                >
                  {data.title}
                </Text>
                <Text
                  tag="p"
                  variant="textXS"
                  class=" mt-1 text-base-600        "
                >
                  {data.description}
                </Text>
              </div>
              <Text
                tag="p"
                variant="textXS"
                class="text-base-600    lg:ml-auto"
              >
                <time datetime={data.period}> {data.period}</time>
              </Text>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
