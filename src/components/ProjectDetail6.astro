---
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Props 정의
interface Props {
  mainImage: string;
  imageAlt: string;
  projectTitle: string;
  currentPage: number;
  totalPages: number;
  category: string;
  services: string[];
  year: string;
  fullDescription: string;
}

const {
  mainImage,
  imageAlt,
  projectTitle,
  currentPage,
  totalPages,
  category,
  services,
  year,
  fullDescription,
} = Astro.props;

// 1. 이미지 및 텍스트 데이터 정의 (단일 배열로 병합하여 1:1 매칭)
const combinedSections = [
    {
        imageUrl: "https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763691853/lumi3_t5cdbo.svg", // 첫 번째 항목 이미지 (원본 유지)
        imageAlt: "Lumi Background Image",
        keyword: "BACKGROUND",
        description: "루미라는 서비스는 '공간은 물리적 영역만이 아닌 인간관계와 감정을 담아내는 풍경이다'라는 에드워드 홀 인류학자의 말에서 출발하게 되었습니다. 에드워드 홀이 인간관계의 거리에 따라 서로를 감각적으로 다르게 인식한다는 점을 주목하고 물리적 거리 위주가 아닌 개인간의 주관적, 감각적 거리를 인식할 수 있는 어플을 만들면 어떨까라는 생각에서 서비스를 기획하게 되었습니다.",
        position: "top: 1%; left: 1% ", 
        textColor: "text-white",
    },
    {
        // ⭐ 이 항목은 imageUrl이 비어 있어도 텍스트가 position에 따라 표시됩니다.
        imageUrl: "https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763692654/lumi3_jsq1cl.svg", 
        imageAlt: "Creative Workshop Section",
        keyword: "RESEARCH", 
        description: "PDI 인터뷰를 통해 사용자가 ‘가까이 있지만 멀게 느껴지는’ 지인을 물리적 공간에서 다시 떠올리고 싶어 한다는 욕구를 확인했습니다. 대상자의 일상 이동 루틴과 주요 장소를 분석해 어떤 순간에 회상도가 높아지는지 파악했으며, 저니맵을 통해 기존의 콘텐츠 중심 SNS가 이러한 거리감을 충분히 해소하지 못하고 있음을 발견했습니다.",
        position: "top: 1%; left: 1%;", // 이미지가 없으므로 이 position은 min-h-[300px] 컨테이너를 기준으로 합니다.
        textColor: "text-base-600",
    },
    {
        imageUrl: "https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763693648/lumi4_es2jlw.svg", 
        imageAlt: "Merch Shop & Cafe Image",
        keyword: "APP FLOW",
        description: "맵핑과 GPS를 기반으로 하여, 사용자가 실제 공간에서 친구 및 지인과 주고받은 공유 기록(텍스트, 사진, 상호작용 위치)을 자동으로 저장하고 관리합니다. 특히, 멀리 떨어져 있는 상황에서도 기록된 상호작용에 기반한 물리적 인터랙션을 제공하여, 사용자들이 언제나 서로 가까이 연결되어 있다는 감성적인 추억을 현실적으로 느낄 수 있도록 하는 데 중점을 둔 앱 플로우입니다.",
        position: "top: 1%; left: 1;", 
        textColor: "text-base-600",
    },
    {
        imageUrl: "https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763693781/lumi5_nnwqld.svg",
        imageAlt: "Award Image",
        keyword: "SERVICE BI",
        description: "늘 곁에 있는 친근한 친구와 같은 이름으로 ‘루미(Lumi)’ 라는 네이밍을 설정하고, 대상을 공간적으로 인지시켜주는 ‘빛’ 과 ‘블룬 아이콘’을 결합하여 서비스의 메인 심볼을 디자인하였습니다. 원색의 컬러와 기하학적 형태를 활용하여 빛의 요소를 직관적으로 나타냅니다.", 
        position: "top: 1%; left: 1%;",
        textColor: "text-base-600",
    },
    {
        imageUrl: "https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763693904/lumi6_bbo3wd.svg", 
        imageAlt: "SNS Contents Design Image",
        keyword: "SERVICE UI",
        description: "앱의 핵심 가치인 '실제 공간에서의 추억 기록 및 공유'를 반영한 디자인이 특징입니다. 사용자의 현재 위치와 기록된 장소를 중심으로 구성하여, 앱을 실행하는 순간부터 연결성을 강조합니다. 상호작용 기록은 장소 기반의 핀이나 아이콘 형태로 시각화되어, 기록 위치를 한눈에 파악할 수 있도록 합니다. 사용자가 따뜻하고 연결된 느낌을 받도록 하는 데 초점을 맞춘 시각적 특징이며 복잡한 정보 표시를 최소화하고, 여백을 충분히 활용하여 사용자의 집중도를 높입니다.",
        position: "top: 0%; left: 1%;", 
        textColor: "text-base-600", 
    },
];

// 헬퍼 함수는 이제 필요 없습니다.
---

<section class="min-h-screen font-sans relative">
  
  <Wrapper variant="standard" class="relative z-10 py-8 lg:py-16">
      {/* 메인 페이지로 돌아가는 타이포그래피 링크와 상단 맥락 (Professional Projects) */}
    <div class="mb-2 px-2 flex justify-between items-end"> 

      {/* 2. 오른쪽: 프로젝트 종류 (작게, 회색) */}
      <Text tag="p" class="text-base-500 uppercase font-medium text-3xl">
        Professional Projects
      </Text>
      
      {/* 1. 왼쪽: 메인 페이지 링크 (크게) */}
      <a href="/" class="text-base-900 font-medium text-3xl hover:opacity-30 transition-opacity">
        Back
      </a>
      
    </div>
    
    {/* 메인 콘텐츠 영역 (기존 내용) */}
    <div class="lg:p-1 rounded-lg text-base-900">
      
      {/* 메인 프로젝트 이미지 */}
      <div class="mb-6 lg:mb-6">
        <img
          src={"https://res.cloudinary.com/dy9kxmf9g/image/upload/v1763516060/image_146_bcve5d.svg"}
          alt={imageAlt}
          width={1200}
          height={800}
          class="w-full aspect-video object-cover rounded-md"
          loading="lazy"
        />
      </div>

      {/* 페이지 번호 */}
      <Text tag="p" variant="textSM" class="text-base-500 mb-2">
        ({currentPage}/{totalPages})
      </Text>

      {/* 제목 및 상세 정보 그리드 (여기가 2열 그리드 시작점) */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 lg:gap-24">
        
        {/* 1열: 프로젝트 제목 */}
        <div>
          <Text tag="h1" variant="text5XL" class="text-5xl font-bold leading-tight mt-0">
            {projectTitle}
          </Text>
        </div>

        {/* 2열: Project Details 및 상세 설명 (상단 상세 설명이 시작되는 곳) */}
        <div class="flex flex-col gap-8">
          
          {/* Project Details 테이블 */}
          <div class="">
            <div class="grid grid-cols-3 gap-y-0 text-sm">
              <Text tag="p" variant="textSM" class="font-medium text-base-800 col-span-full border-b border-base-500 pb-3 mb-0">Project Details</Text>
              <div class="col-span-full grid grid-cols-3 border-b border-base-500 pb-3 mb-0">
                <Text tag="p" variant="textSM" class="font-medium text-base-500 pt-1 col-span-1">Category</Text>
                <Text tag="p" variant="textSM" class="col-span-2 pt-1">{category}</Text>
              </div>
              <div class="col-span-full grid grid-cols-3 border-b border-base-500 pb-3 mb-0">
                <Text tag="p" variant="textSM" class="font-medium text-base-500 pt-1 col-span-1">Services</Text>
                <Text tag="p" variant="textSM" class="col-span-2 pt-1">
                  {services.map(service => (<span class="block">{service}</span>))}
                </Text>
              </div>
              <div class="col-span-full grid grid-cols-3 border-b border-base-500 pb-3 mb-0">
              <Text tag="p" variant="textSM" class="font-medium text-base-500 col-span-1 pt-1">Year</Text>
              <Text tag="p" variant="textSM" class="col-span-2 pt-1">{year}</Text>
              </div>
            </div>
          </div>

          {/* 상세 설명 텍스트 (하드코딩된 내용) */}
          <Text tag="p" variant="textMD" class="leading-relaxed text-base-600 mt-8">루미라는 서비스는 일상 속 감각적 거리를 기록하며 인식할 수 있도록 돕는 슬로우 소셜 어플입니다. SNS처럼 빠른 관계 형성을 강조하는 대신, 루미는 지속 가능한 관계의 형성을 목표로 설계되었습니다. 사용자는 물리적 거리를 넘어 서로 간의 감정적·감각적 상호작용을 기록함으로써 관계의 깊이를 체감할 수 있습니다. 루미는 사랑, 동료, 비즈니스 등 다양한 인간관계 속에서 진정으로 소중한 관계에 집중할 수 있는 환경을 제공합니다. 서비스 기획부터 PDI 사용자 리서치, 컨셉 구현을 중심으로 필요한 기능을 설계하는 것에 집중하여 진행하였습니다.</Text>
            {/* fullDescription Prop 텍스트 (이전 요청에서 수정된 대로 분리) */}
            <Text tag="p" variant="textMD" class="leading-relaxed text-base-600">
             {fullDescription}
            </Text>
        </div>
        {/* 👆 상단 콘텐츠의 2열 끝 👆 */}

      </div> {/* 제목 및 상세 정보 그리드 끝 */}
      
    </div> {/* 메인 콘텐츠 영역 끝 */}

    
    {/* --- 새로운 이미지/텍스트 섹션 (모든 텍스트 absolute 포지션) --- */}
    <div class="grid grid-cols-1 gap-8 pt-10 mt-24"> 
        {combinedSections.map((section) => (
            
            // ⭐ 1. 모든 섹션에 `relative`와 `min-h-[300px]`를 부여하여 텍스트 오버레이 공간을 확보합니다.
            <div 
              class={`mb-8 relative rounded-lg ${!section.imageUrl ? 'bg-base-100 min-h-[300px]' : ''}`}
            > 
                
                {/* 2. 이미지가 있을 때만 렌더링하고, 없을 때는 배경색과 최소 높이로 공간을 대체합니다. */}
                {section.imageUrl ? (
                    <img
                        src={section.imageUrl}
                        alt={section.imageAlt}
                        width={1000}
                        height={800}
                        class="w-full object-cover rounded-lg"
                        loading="lazy"
                    />
                ) : (
                    // 이미지가 없을 때 대체 영역이 필요하다면 여기에 디자인을 추가할 수 있습니다.
                    // 현재는 부모 div의 bg-base-100과 min-h-[300px]가 이 역할을 대신합니다.
                    <div class="w-full h-full p-10">
                        {/* 텍스트가 잘 보이도록 이미지 없는 섹션임을 알리는 요소 추가 가능 */}
                    </div>
                )}


                {/* ⭐ 3. 텍스트 오버레이: 이미지가 있든 없든 항상 absolute로 렌더링 */}
                {section.description && section.description.length > 0 && section.description !== '/' ? (
                    
                    /* 텍스트 컨테이너: absolute와 인라인 스타일을 사용하여 원하는 위치에 배치합니다. */
                    // ⭐ 여기에 2열 그리드를 적용하여 키워드와 설명이 가로로 병렬 배치되도록 수정했습니다.
                    <div 
                      class={`absolute p-6 lg:p-10 text-left grid grid-cols-1 md:grid-cols-2 gap-22`} 
                      style={section.position}
                    >
                        
                        {/* 1열: 키워드 */}
                        <div class="col-span-1">
                            <Text tag="p" variant="textMD" class={`${section.textColor} uppercase font-semibold mb-0`}> 
                                {section.keyword}
                            </Text>
                        </div>

                        {/* 2열: 설명 */}
                        <div class="col-span-1">
                            {/* w-[500px] 대신 w-full을 사용하여 그리드 열 너비에 맞춰지도록 합니다. */}
                            <Text tag="p" variant="textMD" class={`${section.textColor} leading-relaxed w-full`}> 
                                {section.description}
                            </Text>
                        </div>
                    </div>
                ) : null}
                
            </div>
        ))}
    </div>
    {/* --- 새로운 이미지/텍스트 섹션 끝 --- */}
  
  </Wrapper> {/* Wrapper 종료 */}

</section>